# ─── Backend .env ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values. Never commit .env to git.

PORT=5000
NODE_ENV=development

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/questly

# Client URL for CORS (no trailing slash)
CLIENT_URL=http://localhost:3000

# JWT secrets — generate strong random strings in production
# e.g., run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_STRONG_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_STRONG_REFRESH_SECRET

# Token expiry
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
